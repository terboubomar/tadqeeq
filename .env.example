# Database migration connection string used by Drizzle CLI.
DATABASE_URL=

# Supabase server/runtime configuration.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Client-side Supabase values used by Vite.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only AI configuration.
# Never expose OPENAI_API_KEY through a VITE_* variable or commit a real key.
OPENAI_API_KEY=
TADQEEQ_AI_MODEL=gpt-5.6-luna
TADQEEQ_AI_MAX_REQUESTS_PER_HOUR=30
