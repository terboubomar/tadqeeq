# Database migration connection string used by Drizzle CLI.
DATABASE_URL=

# Supabase server/runtime configuration.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Client-side Supabase values used by Vite.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# AI feature switch. Set both values consistently per deployment.
# Server is authoritative; VITE_ only hides client UI.
AI_ENABLED=true
VITE_TADQEEQ_AI_ENABLED=true

# Server-only AI configuration.
# Never expose OPENAI_API_KEY through a VITE_* variable or commit a real key.
OPENAI_API_KEY=
TADQEEQ_AI_MODEL=gpt-5.6-luna
TADQEEQ_AI_MAX_REQUESTS_PER_HOUR=30

# Public HTTPS origin of this deployment. Required in production: the Telegram
# webhook is registered at <origin>/api/public/telegram-webhook. No fallback exists.
TADQEEQ_PUBLIC_URL=https://tadqeeq.app

# Telegram compensation evidence (server-only).
# Never expose these through a VITE_* variable: browser code must not see them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
