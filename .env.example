# Server-only AI configuration.
# Never expose OPENAI_API_KEY through a VITE_* variable or commit a real key.
OPENAI_API_KEY=
TADQEEQ_AI_MODEL=gpt-5.6-luna
TADQEEQ_AI_MAX_REQUESTS_PER_HOUR=30

# Supabase server values are normally injected by the deployment environment.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
