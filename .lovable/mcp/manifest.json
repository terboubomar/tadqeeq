      {
        "name": "get_account",
        "title": "Connected account",
        "description": "Which Tadqeeq account is connected: email, company workspace, role and plan, and whether this assistant may use Tadqeeq (الشاملة plan or the add-on). Call this first, or when other tools return nothing.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "start_audit",
        "title": "Start an invoice audit",
        "description": "Start auditing a delivery-platform invoice. Files cannot be sent through this tool: it returns a secure link (valid 2 hours) where the user uploads the order export and the invoice with the platform and bank fee already filled in. Give the user the link, ask them to come back when the upload says it is done, then call get_audit_result with the returned request_id. For HungerStation ask the user for their card/bank payment fee % first (e.g. 1.8).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "platform": {
              "type": "string",
              "enum": [
                "hungerstation",
                "keeta",
                "jahez"
              ],
              "description": "Delivery platform of the files."
            },
            "bank_fee_pct": {
              "description": "HungerStation only: the card payment fee percentage in the restaurant's contract, e.g. 1.8 for 1.8%.",
              "type": "number",
              "minimum": 0.1,
              "maximum": 10
            },
            "label": {
              "description": "Optional name for the period, e.g. 'سبتمبر 2026'.",
              "type": "string",
              "maxLength": 120
            }
          },
          "required": [
            "platform"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_audit_result",
        "title": "Get the audit result",
        "description": "Result of an audit started with start_audit: the invoice comparison, differences to claim and costliest branches, computed by Tadqeeq's accounting engine. If the upload is not finished yet it says so; ask the user to finish the upload and try again.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "request_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "request_id returned by start_audit."
            }
          },
          "required": [
            "request_id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
