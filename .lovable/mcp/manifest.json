            "status"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "update_exception_status",
        "title": "Update a difference's status",
        "description": "Set the status of one difference found in a period (for example reviewing, claimable, contacted, disputed, recovered, rejected, closed), only when the user asked for that change in this conversation. For recovered, pass the amount recovered. Needs the user's permission to manage exceptions; the change is logged like in the app.",
