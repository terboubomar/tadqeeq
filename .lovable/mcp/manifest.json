      {
        "name": "create_compensation_case",
        "title": "Create a compensation case",
        "description": "Open a new «استرداد» case for one order, only when the user asked for it. Tadqeeq writes the dispute text in Arabic and English from the reason, the explanation and the evidence. Call find_order_evidence first and pass the evidence id when there is one. One case per order and platform; a duplicate is refused. Starts as draft unless status ready is asked for.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "platform": {
              "type": "string",
              "enum": [
                "hungerstation",
                "keeta",
                "jahez"
              ],
              "description": "Delivery platform."
            },
            "order_number": {
              "type": "string",
              "minLength": 3,
              "maxLength": 120,
              "description": "The platform order number."
            },
            "amount_sar": {
              "type": "number",
              "minimum": 0,
              "maximum": 100000,
              "description": "Compensation amount claimed, SAR."
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "description": "Why compensation is due, e.g. 'الطلب سُلّم كاملاً والعميل اشتكى من نقص'."
            },
            "explanation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 6000,
              "description": "What the branch says happened."
            },
            "evidence_id": {
              "description": "Evidence id from find_order_evidence.",
